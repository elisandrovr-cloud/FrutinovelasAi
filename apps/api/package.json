{
  "name": "@fruti/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "worker:dev": "tsx watch src/worker.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@aws-sdk/client-s3": "3.1150.0",
    "@aws-sdk/s3-request-presigner": "3.1150.0",
    "@fastify/cors": "9.0.1",
    "@fruti/shared": "*",
    "@prisma/client": "6.19.3",
    "archiver": "7.0.1",
    "bullmq": "5.81.5",
    "dotenv": "16.4.7",
    "fastify": "4.29.1",
    "p-limit": "6.2.0",
    "pino-pretty": "13.0.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/archiver": "6.0.3",
    "@types/node": "22.10.2",
    "prisma": "6.19.3",
    "tsup": "8.3.5",
    "tsx": "4.19.2",
    "typescript": "5.9.3"
  }
}
