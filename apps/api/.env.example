# ================== Núcleo ==================
NODE_ENV=development
PORT=4000
PUBLIC_API_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000
# Supabase: usa la cadena "Transaction pooler" en DATABASE_URL y la directa en DIRECT_URL
DATABASE_URL=postgresql://fruti:fruti@localhost:5432/frutinovela
DIRECT_URL=postgresql://fruti:fruti@localhost:5432/frutinovela
REDIS_URL=redis://localhost:6379

# ================== Almacenamiento ==================
# local = disco (dev). s3 = Cloudflare R2 / AWS S3 / MinIO
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.storage
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=frutinovelas
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=https://media.tudominio.com

# ================== Proveedores ==================
# "mock" en todos = pipeline completo sin gastar un centavo (placeholders con ffmpeg)
LLM_PROVIDER=mock          # claude | mock
IMAGE_PROVIDER=mock        # fal | mock
VIDEO_PROVIDER=mock        # runway | kling | mock
TTS_PROVIDER=mock          # elevenlabs | mock
LIPSYNC_PROVIDER=none      # synclabs | none  (synclabs requiere STORAGE_DRIVER=s3)
MUSIC_PROVIDER=mock        # library | elevenlabs | mock

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

FAL_KEY=
FAL_TEXT2IMG_MODEL=fal-ai/flux-pro/v1.1-ultra
FAL_EDIT_MODEL=fal-ai/flux-pro/kontext/max/multi

RUNWAY_API_KEY=
RUNWAY_MODEL=gen4_turbo
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
KLING_BASE_URL=https://api-singapore.klingai.com
KLING_MODEL=kling-v2-1

ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
# Opcional: fija tu propio catálogo de voces latinas
# ELEVENLABS_VOICE_CATALOG=[{"id":"xxxx","name":"Valeria","gender":"female","age":"young","accent":"mexican"}]
# NARRATOR_VOICE_ID=

SYNCLABS_API_KEY=
SYNCLABS_MODEL=lipsync-2

# ================== Pipeline ==================
SHOT_CONCURRENCY=2
CHAPTER_CONCURRENCY=2
BURN_SUBTITLES=false
WORK_DIR=tmp
