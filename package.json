{
  "name": "frutinovela-ai",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:api": "npm run dev -w @fruti/api",
    "dev:worker": "npm run worker:dev -w @fruti/api",
    "dev:web": "npm run dev -w @fruti/web",
    "build": "npm run build -w @fruti/shared && npm run build -w @fruti/api && npm run build -w @fruti/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:migrate": "npm run db:migrate -w @fruti/api",
    "db:generate": "npm run db:generate -w @fruti/api"
  },
  "engines": { "node": ">=20" }
}
